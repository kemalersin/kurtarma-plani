# Geliştirme (`npm run dev`) — kopyala: cp .env.development.example .env.development
VITE_LOCAL_SENKRONLA_PACKAGES=false # false = npm @senkronla/* tercih; paket yoksa ../senkronla veya SENKRONLA_ROOT fallback
VITE_ESR_RELAY_URL=http://localhost:8080/v1 # ya da https://sync.senkron.la/v1
VITE_ESR_APP_ID=esr_app_kurtar_co
